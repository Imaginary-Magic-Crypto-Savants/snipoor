# SAVANTSNIPOR build-time env (webpack DefinePlugin). Copy to .env and fill in.
# Real .env is gitignored — never commit keys.

# --- Bundled API keys (round-robined at runtime) ---
ALCHEMY_API_KEY_1=
ALCHEMY_API_KEY_2=
ALCHEMY_API_KEY_3=   # pay-as-you-go overflow / Robinhood chain
ETHERSCAN_API_KEY=
OPENSEA_KEY_1=
OPENSEA_KEY_2=

# --- Access gating (license backend) ---
# Base URL of the auth endpoints (savants site). Defaults to https://api.imcs.world
# if unset. Uses a dedicated subdomain so the backend can be relocated via DNS
# without re-publishing the extension (the URL is baked into the shipped CRX).
LICENSE_API_URL=https://api.imcs.world
# Master switch. Unset/false = gate BYPASSED (dev): the popup skips the gate
# entirely, wallet/mint work is never blocked. Set true for beta/prod to enforce.
LICENSE_ENABLED=false
# Admin/dev bypass code. When the gate is ENABLED, typing exactly this code at the
# gate unlocks locally without a backend (for testing the gate flow). Leave UNSET
# in beta/production builds so no bypass ships.
DEV_BYPASS_CODE=
